{
  "expo": {
    "name": "SplitMori",
    "slug": "splitmori",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "extra": {
      "lifetimeProProductId": "com.zhushunli.splitmori.pro.lifetime",
      "eas": {
        "projectId": "4fde99a1-04c3-44db-8791-bc88fae5dab5"
      },
      "legalSiteOrigin": "https://splitmori-site.vercel.app"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.zhushunli.splitmori",
      "appleTeamId": "8SSF5V63H9",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleLocalizations": [
          "zh-HK",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "3B52.1"]
          }
        ]
      }
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": [
            "zh-HK",
            "en"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "允許 SplitMori 將結算圖儲存到相簿。 Allow SplitMori to save settlement images to Photos.",
          "granularPermissions": []
        }
      ]
    ],
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "owner": "homeypaw"
  }
}
